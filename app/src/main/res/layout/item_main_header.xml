<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="-20dp"
    android:layout_marginEnd="-20dp"
    android:layout_marginBottom="4dp"
    android:clipToPadding="false"
    android:gravity="center_vertical"
    android:minHeight="64dp"
    android:paddingHorizontal="20dp">

    <!-- Profile / account (opens settings, long-press cycles users) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/accountsCont"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/neu_circle_light"
        app:cardBackgroundColor="@android:color/transparent"
        app:cardCornerRadius="24dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp">

        <ImageView
            android:id="@+id/accounts"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/extensions"
            android:padding="6dp"
            android:src="@drawable/ic_account_circle_32dp"
            app:tint="@color/icon_on_light" />
    </com.google.android.material.card.MaterialCardView>

    <!-- Greeting / screen title -->
    <TextView
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:text="@string/app_name"
        android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
        android:textColor="?colorOnSurface"
        android:textStyle="bold"
        tools:text="Good evening" />

    <!-- Extension switcher (opens extension list, long-press cycles extensions) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/extensionsCont"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/neu_circle_light"
        app:cardBackgroundColor="@android:color/transparent"
        app:cardCornerRadius="24dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp">

        <ImageView
            android:id="@+id/extensions"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/extensions"
            android:padding="12dp"
            android:src="@drawable/ic_extension_32dp"
            app:tint="@color/icon_on_light" />
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
